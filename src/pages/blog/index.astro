---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout
  title="Journal — 杨晔塬"
  description="技术笔记与思考，记录后端开发、分布式系统和 AI Agent 相关实践。"
  slug="blog"
  ogType="website"
>
  <section
    class="relative max-w-5xl mx-auto px-5 sm:px-8 pt-20 sm:pt-28 pb-16 sm:pb-24
           animate-fade-in-up animate-section-1"
  >
    <div class="flex items-end justify-between mb-12 sm:mb-16">
      <div>
        <span class="eyebrow">— Journal</span>
        <h1
          class="font-display mt-3 text-4xl sm:text-5xl md:text-6xl tracking-tight"
          style="color: var(--color-text); font-weight: 400;"
        >
          Notes,
          <span style="font-style: italic; color: var(--color-text-muted);">
            collected over time.
          </span>
        </h1>
      </div>
      <div
        class="hidden md:block text-right text-[0.72rem] tracking-[0.2em] uppercase shrink-0 ml-6"
        style="color: var(--color-text-faint);"
      >
        {posts.length.toString().padStart(2, "0")} posts
      </div>
    </div>

    {
      allTags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-10">
          {allTags.map((tag) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )
    }

    {
      posts.length === 0 ? (
        <p class="text-center py-20" style="color: var(--color-text-muted);">
          还没有文章，敬请期待。
        </p>
      ) : (
        <div class="flex flex-col gap-5 sm:gap-6 animate-stagger-children">
          {posts.map((post) => (
            <a
              href={`/blog/post/${post.id}`}
              class="group block glass-card gradient-border px-6 sm:px-8 py-6 sm:py-7 no-underline"
            >
              <article>
                <div class="flex items-center gap-4 mb-3">
                  <time
                    class="text-xs tracking-[0.14em] uppercase"
                    style="color: var(--color-text-muted);"
                  >
                    {post.data.date.toLocaleDateString("zh-CN", {
                      year: "numeric",
                      month: "2-digit",
                      day: "2-digit",
                    })}
                  </time>
                  {post.data.tags.length > 0 && (
                    <div class="flex items-center gap-1.5">
                      {post.data.tags.map((tag) => (
                        <span class="tag-chip text-[0.65rem]">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>

                <h2
                  class="font-display text-xl sm:text-2xl md:text-3xl mb-3 tracking-tight leading-tight
                         transition-colors duration-300"
                  style="color: var(--color-text); font-weight: 500;"
                >
                  {post.data.title}
                </h2>

                <p
                  class="text-sm sm:text-[0.95rem] leading-relaxed"
                  style="color: var(--color-text-soft);"
                >
                  {post.data.description}
                </p>

                <div
                  class="inline-flex items-center gap-2 mt-4 text-sm font-medium
                         transition-all duration-300"
                  style="color: var(--color-accent);"
                >
                  <span>Read more</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </article>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>
