---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const accents = ["var(--nb-yellow)", "var(--nb-blue)", "var(--nb-red)", "var(--nb-green)"];
---

<Layout
  title="Journal — 杨晔塬"
  description="技术笔记与思考，记录后端开发、分布式系统和 AI Agent 相关实践。"
  slug="blog"
  ogType="website"
>
  <section
    class="relative max-w-5xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-12 sm:pb-16"
  >
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8 sm:mb-10 nb-pop nb-delay-1">
      <div>
        <span class="nb-label">Journal</span>
        <h1
          class="font-display mt-4 text-4xl sm:text-5xl md:text-6xl"
          style="color: var(--color-text);"
        >
          笔记
        </h1>
      </div>
      <div
        class="font-mono text-xs font-bold tracking-[0.16em] uppercase px-3 py-1.5"
        style="border: var(--nb-border-w) solid var(--color-ink); color: var(--color-text);"
      >
        {posts.length.toString().padStart(2, "0")} posts
      </div>
    </div>

    {
      allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8 nb-pop nb-delay-2">
          {allTags.map((tag) => (
            <span class="nb-tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      posts.length === 0 ? (
        <div
          class="nb-box nb-shadow px-6 py-14 text-center font-mono text-sm font-bold uppercase tracking-[0.14em]"
          style="color: var(--color-text-muted);"
        >
          还没有文章，敬请期待
        </div>
      ) : (
        <div class="flex flex-col gap-5 sm:gap-6 nb-stagger">
          {posts.map((post, idx) => {
            const accent = accents[idx % accents.length];
            return (
              <a href={`/blog/post/${post.id}`} class="nb-card block nb-pop">
                <article>
                  <!-- 顶部色条：日期 + 标签 -->
                  <div
                    class="flex flex-wrap items-center gap-3 px-4 sm:px-5 py-2"
                    style={`background: ${accent}; border-bottom: var(--nb-border-w) solid var(--color-ink);`}
                  >
                    <time
                      class="font-mono text-xs font-bold tracking-[0.14em]"
                      style="color: #0a0a0a;"
                    >
                      {post.data.date.toLocaleDateString("zh-CN", {
                        year: "numeric",
                        month: "2-digit",
                        day: "2-digit",
                      })}
                    </time>
                    {post.data.tags.length > 0 && (
                      <div class="flex flex-wrap items-center gap-1.5">
                        {post.data.tags.map((tag) => (
                          <span
                            class="font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] px-1.5 py-0.5"
                            style="border: 2px solid #0a0a0a; color: #0a0a0a;"
                          >
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  <div class="px-5 sm:px-7 py-5 sm:py-6">
                    <h2
                      class="font-display text-xl sm:text-2xl md:text-3xl mb-3 leading-tight"
                      style="color: var(--color-text);"
                    >
                      {post.data.title}
                    </h2>

                    <p
                      class="text-sm sm:text-[0.95rem] leading-relaxed"
                      style="color: var(--color-text-soft);"
                    >
                      {post.data.description}
                    </p>

                    <span
                      class="inline-flex items-center gap-2 mt-4 font-mono text-xs font-bold uppercase tracking-[0.1em]"
                      style="color: var(--color-text); border-bottom: 3px solid var(--color-ink);"
                    >
                      <span>Read more</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </span>
                  </div>
                </article>
              </a>
            );
          })}
        </div>
      )
    }
  </section>
</Layout>
