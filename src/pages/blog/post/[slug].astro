---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<Layout
  title={`${post.data.title} — 杨晔塬`}
  description={post.data.description}
  slug={`blog/post/${post.id}`}
  ogType="article"
>
  <article class="px-6 sm:px-14 pt-10 sm:pt-14 pb-12 sm:pb-16">
    <!-- Back link -->
    <a href="/" class="ed-btn mb-10 ed-rise">
      <span>All posts</span>
    </a>

    <!-- Article header — 眉批 + 大标题 + 细线分隔 -->
    <header
      class="pb-8 mb-10 ed-rise ed-delay-1"
      style="border-bottom: 1px solid var(--color-border);"
    >
      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <time
          class="font-mono text-[0.7rem] tracking-[0.12em]"
          style="color: var(--ed-accent);"
        >
          {
            post.data.date.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            })
          }
        </time>
        {
          post.data.updated && (
            <span
              class="font-mono text-[0.66rem] tracking-[0.12em] uppercase"
              style="color: var(--color-text-muted);"
            >
              Updated{" "}
              {post.data.updated.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
              })}
            </span>
          )
        }
      </div>

      <!-- Title -->
      <h1
        class="font-display text-3xl sm:text-4xl md:text-5xl leading-[1.1] mb-4"
        style="color: var(--color-text);"
      >
        {post.data.title}
      </h1>

      <!-- Description (subtitle) -->
      <p
        class="text-base sm:text-lg leading-relaxed"
        style="color: var(--color-text-muted);"
      >
        {post.data.description}
      </p>

      <!-- Tags -->
      {
        post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-5">
            {post.data.tags.map((tag) => (
              <span class="ed-tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <!-- Article body -->
    <div class="prose-custom" set:html={post.rendered?.html ?? ""}>
    </div>

    <!-- Footer nav -->
    <hr
      class="mt-14 mb-7"
      style="border: none; border-top: 1px solid var(--color-border);"
    />
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="ed-btn">
        <span>All posts</span>
      </a>
      <a href="/about" class="ed-btn">
        <span>About</span>
        <span class="ed-arrow" aria-hidden="true"></span>
      </a>
    </div>
  </article>
</Layout>
