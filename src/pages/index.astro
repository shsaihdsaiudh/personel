---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Personel" description="A minimalist personal homepage.">
  <div class="max-w-3xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight mb-4">
      Hey, I'm <span class="underline decoration-black/20">Your Name</span>
    </h1>
    <p class="text-lg text-black/60 max-w-xl">
      Welcome to my personal space on the internet.
      This is a minimalist Astro + Tailwind CSS v4 starter.
    </p>
  </div>
</Layout>
