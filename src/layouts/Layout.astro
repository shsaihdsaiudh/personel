---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  /** 页面 slug 用于 canonical URL，首页传 "" */
  slug?: string;
  /** 页面类型：默认 "website"，文章页用 "article" */
  ogType?: "website" | "article" | "profile";
}

const {
  title,
  description = "极简黑白风格的个人主页，展示项目经历与技术能力。",
  slug = "",
  ogType = "website",
} = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://example.com";
const canonical = slug ? `${siteUrl}/${slug}` : siteUrl;
const ogImage = `${siteUrl}/og-image.png`;

// JSON-LD Person schema
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Your Name",
  url: siteUrl,
  image: ogImage,
  jobTitle: "全栈开发者",
  description: "全栈开发者 / 开源爱好者",
  sameAs: [
    "https://github.com",
    "https://linkedin.com",
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <title>{title}</title>

    <!-- JSON-LD 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)}>
    </script>

    <!-- 主题初始化：防止闪烁 -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>

  <body class="flex flex-col min-h-screen">
    <!-- Header -->
    <header
      class="border-b border-black/10 dark:border-slate-700/50
             bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm
             sticky top-0 z-10 transition-colors duration-300"
    >
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between">
        <a
          href="/"
          class="text-base sm:text-lg font-semibold no-underline hover-hover:opacity-70 transition-opacity
                 dark:text-slate-100"
        >
          {title}
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <nav class="flex gap-3 sm:gap-6 text-xs sm:text-sm">
            <a
              href="/"
              class="dark:text-slate-300 dark:hover:text-slate-100
                     link-underline decoration-1"
            >
              Home
            </a>
            <a
              href="/about"
              class="dark:text-slate-300 dark:hover:text-slate-100
                     link-underline decoration-1"
            >
              About
            </a>
            <a
              href="/blog"
              class="dark:text-slate-300 dark:hover:text-slate-100
                     link-underline decoration-1"
            >
              Blog
            </a>
          </nav>

          <!-- 主题切换按钮 -->
          <button
            id="theme-toggle"
            class="theme-toggle-btn ml-2 sm:ml-4"
            aria-label="切换主题"
            title="切换亮色/暗色主题"
          >
            <!-- 太阳图标（暗色模式下显示） -->
            <svg
              class="icon-sun"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="5" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
            <!-- 月亮图标（亮色模式下显示） -->
            <svg
              class="icon-moon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- 主内容区 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="border-t border-black/10 dark:border-slate-700/50 mt-auto
             transition-colors duration-300"
    >
      <div
        class="max-w-3xl mx-auto px-4 sm:px-6 py-5 sm:py-6 text-center text-xs
               text-black/40 dark:text-slate-500"
      >
        &copy; {new Date().getFullYear()} {title}. All rights reserved.
      </div>
    </footer>

    <!-- 主题切换逻辑 -->
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const btn = document.getElementById("theme-toggle");

        function applyTheme(theme) {
          html.setAttribute("data-theme", theme);
        }

        // 监听系统主题变化（仅在用户未手动设置时生效）
        const mql = window.matchMedia("(prefers-color-scheme: dark)");
        mql.addEventListener("change", (e) => {
          if (!localStorage.getItem("theme")) {
            applyTheme(e.matches ? "dark" : "light");
          }
        });

        // 按钮点击切换
        btn?.addEventListener("click", () => {
          const current = html.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          localStorage.setItem("theme", next);
          applyTheme(next);
        });
      })();
    </script>
  </body>
</html>
