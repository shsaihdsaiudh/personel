---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  /** 页面 slug 用于 canonical URL，首页传 "" */
  slug?: string;
  /** 页面类型：默认 "website"，文章页用 "article" */
  ogType?: "website" | "article" | "profile";
}

const {
  title,
  description = "杨晔塬 — AI Agent 开发，现于腾讯实习。做长时 Agent 执行框架与流程编排。",
  slug = "",
  ogType = "website",
} = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://example.com";
const canonical = slug ? `${siteUrl}/${slug}` : siteUrl;
const ogImage = `${siteUrl}/og-image.png`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// JSON-LD Person schema
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "杨晔塬",
  url: siteUrl,
  image: ogImage,
  jobTitle: "AI Agent 开发",
  description: "AI Agent 开发 / 腾讯实习 / 电子科技大学信息与通信工程 / 长时 Agent 执行框架与流程编排",
  worksFor: {
    "@type": "Organization",
    name: "腾讯",
  },
  sameAs: ["https://github.com/shsaihdsaiudh"],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe7" />
    <meta name="color-scheme" content="light dark" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="杨晔塬" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Fonts: Anton (拉丁展示) + Noto Sans SC (中文标题) + Inter (正文) + JetBrains Mono (戳记) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+SC:wght@500;700;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- JSON-LD 结构化数据 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd, null, 2)}
    >
    </script>

    <!-- 主题初始化：防止闪烁 -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>

  <body>
    <div class="ed-frame">
      <!-- 刊头 -->
      <header
        class="sticky top-0 z-20"
        style="background: var(--color-bg); border-bottom: 1px solid var(--color-border);"
      >
        <div class="px-6 sm:px-14 py-4 flex items-center justify-between gap-3">
          <a href="/" class="flex items-center gap-2.5" aria-label="首页">
            <span class="ed-mark" aria-hidden="true"></span>
            <span class="font-mono text-sm font-bold tracking-[0.06em]" style="color: var(--color-text);">
              shsaihdsaiudh
            </span>
            <span class="ed-stamp hidden sm:inline-block">自留地</span>
          </a>

          <div class="flex items-center gap-4 sm:gap-7">
            <nav class="flex items-center gap-4 sm:gap-7">
              <a
                href="/"
                class="ed-nav-link"
                aria-current={isActive("/") ? "page" : undefined}>Index</a
              >
              <a
                href="/about"
                class="ed-nav-link"
                aria-current={isActive("/about") ? "page" : undefined}>About</a
              >
              <a
                href="mailto:2776079516@qq.com"
                class="ed-nav-link hidden sm:inline-block">Contact</a
              >
            </nav>

            <!-- 主题切换按钮 -->
            <button
              id="theme-toggle"
              class="ed-theme-btn"
              aria-label="切换主题"
              title="切换亮色/暗色主题"
            >
              <svg
                class="icon-sun"
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <line x1="12" y1="2" x2="12" y2="4"></line>
                <line x1="12" y1="20" x2="12" y2="22"></line>
                <line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line>
                <line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line>
                <line x1="2" y1="12" x2="4" y2="12"></line>
                <line x1="20" y1="12" x2="22" y2="12"></line>
                <line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line>
                <line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line>
              </svg>
              <svg
                class="icon-moon"
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </header>

      <!-- 主内容区 -->
      <main class="flex-1">
        <slot />
      </main>

      <!-- 页脚 -->
      <footer
        class="mt-16 sm:mt-20"
        style="border-top: 1px solid var(--color-border);"
      >
        <div
          class="px-6 sm:px-14 py-8 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6"
        >
          <div class="flex flex-col gap-2.5">
            <span class="flex items-center gap-2.5">
              <span class="ed-mark ed-mark-sm" aria-hidden="true"></span>
              <span class="font-display text-base" style="color: var(--color-text);">
                杨晔塬
              </span>
            </span>
            <span class="flex gap-4">
              <a
                href="https://github.com/shsaihdsaiudh"
                target="_blank"
                rel="noopener noreferrer"
                class="ed-link text-xs"
                style="color: var(--color-text-muted);">GitHub</a
              >
              <a
                href="mailto:2776079516@qq.com"
                class="ed-link text-xs"
                style="color: var(--color-text-muted);">Email</a
              >
              <a
                href="/rss.xml"
                class="ed-link text-xs"
                style="color: var(--color-text-muted);">RSS</a
              >
            </span>
          </div>
          <div
            class="font-mono text-[0.66rem] leading-relaxed tracking-[0.08em] uppercase sm:text-right"
            style="color: var(--color-text-muted);"
          >
            &copy; {new Date().getFullYear()} 杨晔塬<br />Astro + Tailwind
          </div>
        </div>
      </footer>
    </div>

    <!-- 主题切换逻辑 -->
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const btn = document.getElementById("theme-toggle");
        function applyTheme(theme) {
          html.setAttribute("data-theme", theme);
        }
        const mql = window.matchMedia("(prefers-color-scheme: dark)");
        mql.addEventListener("change", (e) => {
          if (!localStorage.getItem("theme")) {
            applyTheme(e.matches ? "dark" : "light");
          }
        });
        btn?.addEventListener("click", () => {
          const current = html.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          localStorage.setItem("theme", next);
          applyTheme(next);
        });
      })();
    </script>
  </body>
</html>
