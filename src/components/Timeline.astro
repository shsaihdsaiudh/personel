---
import type { ExperienceItem } from "../data/experience";

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;

// 循环用的强调色，让每条经历的时间块颜色不同
const accents = ["var(--nb-blue)", "var(--nb-red)", "var(--nb-green)", "var(--nb-lilac)"];
---

<section class="relative max-w-5xl mx-auto px-5 sm:px-8 py-10 sm:py-14">
  <!-- Section header -->
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8 sm:mb-10">
    <div>
      <span class="nb-label" style="background: var(--nb-lilac);">01 / Experience</span>
      <h2
        class="font-display mt-4 text-4xl sm:text-5xl md:text-6xl"
        style="color: var(--color-text);"
      >
        经历
      </h2>
    </div>
    <div
      class="font-mono text-xs font-bold tracking-[0.16em] uppercase px-3 py-1.5"
      style="border: var(--nb-border-w) solid var(--color-ink); color: var(--color-text);"
    >
      {items.length.toString().padStart(2, "0")} entries
    </div>
  </div>

  <ul class="flex flex-col gap-5 sm:gap-6 nb-stagger" role="list">
    {
      items.map((item, idx) => (
        <li class="nb-pop">
          <div class="flex flex-col sm:flex-row sm:items-stretch gap-3 sm:gap-0">
            <!-- 时间块：实心色块，桌面端贴在卡片左侧 -->
            <div
              class="shrink-0 sm:w-40 flex items-center justify-center px-4 py-2 sm:py-0"
              style={`border: var(--nb-border-w) solid var(--color-ink); background: ${accents[idx % accents.length]}; box-shadow: 3px 3px 0 0 var(--color-ink);`}
            >
              <span
                class="font-mono text-sm font-bold tracking-[0.06em] text-center"
                style="color: #0a0a0a;"
              >
                {item.time}
              </span>
            </div>

            <!-- 内容卡片 -->
            <div class="flex-1 nb-card px-5 sm:px-7 py-5 sm:py-6 sm:ml-5">
              <h3
                class="font-display text-xl sm:text-2xl mb-2"
                style="color: var(--color-text);"
              >
                {item.organization}
              </h3>
              <p
                class="font-mono text-[0.72rem] font-bold tracking-[0.12em] uppercase inline-block px-2 py-0.5 mb-3"
                style={`border: 2px solid var(--color-ink); background: ${accents[idx % accents.length]}; color: #0a0a0a;`}
              >
                {item.role}
              </p>
              <p
                class="text-sm sm:text-[0.95rem] leading-relaxed"
                style="color: var(--color-text-soft);"
              >
                {item.description}
              </p>
              {item.highlights && item.highlights.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {item.highlights.map((h) => (
                    <span class="nb-tag">{h}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>
