---
import type { ExperienceItem } from "../data/experience";

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<section
  class="relative max-w-5xl mx-auto px-5 sm:px-8 py-16 sm:py-24
         animate-fade-in-up animate-section-2"
>
  <!-- Section header -->
  <div class="flex items-end justify-between mb-12 sm:mb-16">
    <div>
      <span class="eyebrow">— 01 / Experience</span>
      <h2
        class="font-display mt-3 text-4xl sm:text-5xl md:text-6xl tracking-tight"
        style="color: var(--color-text); font-weight: 400;"
      >
        A path,
        <span style="font-style: italic; color: var(--color-text-muted);">
          one chapter at a time.
        </span>
      </h2>
    </div>
    <div
      class="hidden md:block text-right text-[0.72rem] tracking-[0.2em] uppercase shrink-0 ml-6"
      style="color: var(--color-text-faint);"
    >
      {items.length.toString().padStart(2, "0")} entries
    </div>
  </div>

  <div class="relative">
    <!-- Vertical rail (desktop) -->
    <div class="hidden sm:block timeline-rail" aria-hidden="true"></div>

    <ul class="flex flex-col gap-6 sm:gap-8 animate-stagger-children" role="list">
      {
        items.map((item) => (
          <li
            class="relative flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-0
                   animate-fade-in-up"
          >
            <!-- Time -->
            <div
              class="
                shrink-0 sm:w-[9.25rem] sm:pr-10 sm:text-right
                font-display italic mb-1 sm:mb-0 sm:pt-0.5
                text-sm sm:text-base
              "
              style="color: var(--color-text-muted); letter-spacing: 0.01em;"
            >
              {item.time}
            </div>

            <!-- Dot on rail (desktop) -->
            <span class="hidden sm:block timeline-dot" aria-hidden="true" />

            <!-- Card -->
            <div
              class="flex-1 glass-card gradient-border px-5 sm:px-7 py-5 sm:py-6 sm:ml-8"
            >
              <div class="flex items-baseline justify-between gap-3 mb-1">
                <h3
                  class="font-display text-lg sm:text-xl"
                  style="color: var(--color-text); font-weight: 500;"
                >
                  {item.organization}
                </h3>
              </div>
              <p
                class="text-xs sm:text-sm tracking-[0.14em] uppercase mb-3"
                style="color: var(--color-accent); font-weight: 500;"
              >
                {item.role}
              </p>
              <p
                class="text-sm sm:text-[0.95rem] leading-relaxed"
                style="color: var(--color-text-soft);"
              >
                {item.description}
              </p>
              {item.highlights && item.highlights.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {item.highlights.map((h) => (
                    <span class="tag-chip" style="color: var(--color-accent); border-color: var(--color-accent);">
                      {h}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
