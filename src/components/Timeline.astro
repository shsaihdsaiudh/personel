---
import type { ExperienceItem } from "../data/experience";

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<section
  class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16
         animate-fade-in-up animate-section-2"
>
  <h2 class="text-xl sm:text-2xl font-bold tracking-tight mb-8 sm:mb-10 dark:text-slate-100">
    经历
  </h2>

  <div class="relative">
    <!-- 垂直时间线：仅平板+显示 -->
    <div
      class="
        hidden sm:block
        absolute left-[8.5rem] top-2 bottom-0
        w-px bg-black/[0.08] dark:bg-slate-600/40
      "
      aria-hidden="true"
    ></div>

    <ul
      class="flex flex-col gap-6 sm:gap-8 animate-stagger-children"
      role="list"
    >
      {
        items.map((item) => (
          <li class="flex flex-col sm:flex-row sm:items-start gap-1.5 sm:gap-0">
            <!-- 左侧时间 -->
            <div
              class="
                shrink-0 sm:w-[8.5rem] sm:pr-8 sm:text-right
                text-xs sm:text-sm text-black/40 dark:text-slate-500
                tracking-wide mb-1 sm:mb-0
              "
            >
              {item.time}
            </div>

            <!-- 右侧内容卡片 -->
            <div
              class="
                flex-1 card-hover
                bg-white dark:bg-slate-800
                border border-black/[0.06] dark:border-slate-700/50
                rounded-lg px-4 sm:px-5 py-3 sm:py-4
              "
            >
              <h3
                class="font-semibold text-black/85 dark:text-slate-100
                       leading-snug text-sm sm:text-base"
              >
                {item.organization}
              </h3>
              <p class="text-xs sm:text-sm text-black/50 dark:text-slate-400 mt-0.5 mb-1.5 sm:mb-2">
                {item.role}
              </p>
              <p
                class="text-xs sm:text-sm text-black/60 dark:text-slate-400
                       leading-relaxed"
              >
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
