---
import type { ExperienceItem } from "../data/experience";

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<section
  class="px-6 sm:px-14 py-10 sm:py-14"
  style="border-top: 1px solid var(--color-border);"
>
  <!-- Section header -->
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8 sm:mb-10">
    <div>
      <p class="ed-eyebrow mb-5"><span class="bar"></span>01 / Experience</p>
      <h2
        class="text-2xl sm:text-3xl"
        style="color: var(--color-text); font-weight: 800;"
      >
        经历
      </h2>
    </div>
    <span class="ed-stamp">{items.length.toString().padStart(2, "0")} entries</span>
  </div>

  <ul class="flex flex-col ed-stagger" role="list">
    {
      items.map((item) => (
        <li
          class="ed-rise py-7 first:pt-0"
          style="border-top: 1px solid var(--color-border);"
        >
          <div class="flex flex-col sm:flex-row gap-2 sm:gap-8">
            <!-- 时间戳 -->
            <div class="shrink-0 sm:w-40 sm:pt-1.5">
              <span
                class="font-mono text-[0.7rem] tracking-[0.1em] uppercase"
                style="color: var(--ed-accent);"
              >
                {item.time}
              </span>
            </div>

            <!-- 内容 -->
            <div class="flex-1">
              <h3
                class="font-display text-xl sm:text-2xl mb-2"
                style="color: var(--color-text);"
              >
                {item.organization}
              </h3>
              <p
                class="font-mono text-[0.68rem] tracking-[0.14em] uppercase inline-block px-2 py-0.5 mb-3"
                style="border: 1px solid var(--color-border-strong); border-radius: 3px; color: var(--color-text-muted);"
              >
                {item.role}
              </p>
              <p
                class="text-sm sm:text-[0.95rem] leading-relaxed"
                style="color: var(--color-text-soft);"
              >
                {item.description}
              </p>
              {item.highlights && item.highlights.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {item.highlights.map((h) => (
                    <span class="ed-tag">{h}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>
