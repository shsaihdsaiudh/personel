---
import type { ProjectItem } from "../data/projects";

interface Props {
  items: ProjectItem[];
}

const { items } = Astro.props;
---

<section class="max-w-3xl mx-auto px-6 py-16">
  <h2 class="text-2xl font-bold tracking-tight mb-10">项目</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      items.map((item) => (
        <article
          class="
            flex flex-col
            bg-white
            border border-black/[0.06]
            rounded-lg p-5
            transition-all duration-300
            hover:-translate-y-1
            hover:shadow-[0_12px_32px_-8px_rgba(0,0,0,0.1)]
            hover:border-black/12
          "
        >
          <!-- 项目名 -->
          <h3 class="font-semibold text-black/85 leading-snug mb-2">
            {item.name}
          </h3>

          <!-- 简介 -->
          <p class="text-sm text-black/55 leading-relaxed mb-4 flex-1">
            {item.description}
          </p>

          <!-- 技术栈标签 -->
          <div class="flex flex-wrap gap-1.5 mb-4">
            {item.techStack.map((tech) => (
              <span
                class="
                  inline-block
                  px-2.5 py-0.5
                  rounded-full
                  text-xs text-black/45
                  bg-black/[0.03]
                  border border-black/[0.05]
                "
              >
                {tech}
              </span>
            ))}
          </div>

          <!-- 链接按钮 -->
          {item.link && (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="
                self-start
                inline-flex items-center gap-1.5
                text-sm text-black/50
                px-3 py-1.5
                rounded-lg
                border border-black/[0.06]
                no-underline
                transition-all duration-200
                hover:text-black hover:border-black/20 hover:bg-black/[0.02]
              "
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" x2="21" y1="14" y2="3" />
              </svg>
              {item.linkText ?? "查看项目"}
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
