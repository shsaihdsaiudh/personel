---
import type { ProjectItem } from "../data/projects";

interface Props {
  items: ProjectItem[];
}

const { items } = Astro.props;
---

<section
  class="px-6 sm:px-14 py-10 sm:py-14"
  style="border-top: 1px solid var(--color-border);"
>
  <!-- Section header -->
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8 sm:mb-10">
    <div>
      <p class="ed-eyebrow mb-5"><span class="bar"></span>02 / Projects</p>
      <h2
        class="text-2xl sm:text-3xl"
        style="color: var(--color-text); font-weight: 800;"
      >
        项目
      </h2>
    </div>
    <span class="ed-stamp">{items.length.toString().padStart(2, "0")} works</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 ed-stagger">
    {
      items.map((item, idx) => (
        <article class="ed-card ed-rise flex flex-col px-6 py-6">
          <!-- 编号 -->
          <div
            class="font-anton text-3xl mb-4"
            style="color: var(--ed-accent);"
            aria-hidden="true"
          >
            /{(idx + 1).toString().padStart(2, "0")}
          </div>

          <h3
            class="font-display text-xl sm:text-2xl leading-tight mb-3"
            style="color: var(--color-text);"
          >
            {item.name}
          </h3>

          <p
            class="text-sm leading-relaxed mb-5 flex-1"
            style="color: var(--color-text-soft);"
          >
            {item.description}
          </p>

          <div class="flex flex-wrap gap-2 mb-5">
            {item.techStack.map((tech) => (
              <span class="ed-tag">{tech}</span>
            ))}
          </div>

          {item.link && (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="ed-btn self-start"
            >
              <span>{item.linkText ?? "View project"}</span>
              <span class="ed-arrow" aria-hidden="true"></span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
