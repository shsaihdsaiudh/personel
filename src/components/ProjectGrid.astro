---
import type { ProjectItem } from "../data/projects";

interface Props {
  items: ProjectItem[];
}

const { items } = Astro.props;
---

<section
  class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16
         animate-fade-in-up animate-section-3"
>
  <h2 class="text-xl sm:text-2xl font-bold tracking-tight mb-8 sm:mb-10 dark:text-slate-100">
    项目
  </h2>

  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5
           animate-stagger-children"
  >
    {
      items.map((item) => (
        <article
          class="
            flex flex-col
            card-hover
            bg-white dark:bg-slate-800
            border border-black/[0.06] dark:border-slate-700/50
            rounded-lg p-4 sm:p-5
          "
        >
          <!-- 项目名 -->
          <h3
            class="font-semibold text-black/85 dark:text-slate-100
                   leading-snug mb-1.5 sm:mb-2 text-sm sm:text-base"
          >
            {item.name}
          </h3>

          <!-- 简介 -->
          <p
            class="text-xs sm:text-sm text-black/55 dark:text-slate-400
                   leading-relaxed mb-3 sm:mb-4 flex-1"
          >
            {item.description}
          </p>

          <!-- 技术栈标签 -->
          <div class="flex flex-wrap gap-1 sm:gap-1.5 mb-3 sm:mb-4">
            {item.techStack.map((tech) => (
              <span
                class="
                  inline-block
                  px-2 sm:px-2.5 py-0.5
                  rounded-full
                  text-[10px] sm:text-xs text-black/45 dark:text-slate-400
                  bg-black/[0.03] dark:bg-slate-700/30
                  border border-black/[0.05] dark:border-slate-600/40
                "
              >
                {tech}
              </span>
            ))}
          </div>

          <!-- 链接按钮 -->
          {item.link && (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="
                self-start
                inline-flex items-center gap-1.5
                text-xs sm:text-sm text-black/50 dark:text-slate-400
                px-2.5 sm:px-3 py-1.5
                rounded-lg
                border border-black/[0.06] dark:border-slate-600/40
                no-underline
                link-underline
                transition-all duration-200
                hover-hover:text-black dark:hover-hover:text-slate-100
                hover-hover:border-black/20 dark:hover-hover:border-slate-500
                hover-hover:bg-black/[0.02] dark:hover-hover:bg-slate-700/30
                active:text-black dark:active:text-slate-100
                active:border-black/30 dark:active:border-slate-400
                active:bg-black/[0.05] dark:active:bg-slate-600/40
              "
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" x2="21" y1="14" y2="3" />
              </svg>
              {item.linkText ?? "查看项目"}
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
